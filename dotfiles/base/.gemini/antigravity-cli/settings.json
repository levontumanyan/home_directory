{
  "allowNonWorkspaceAccess": true,
  "colorScheme": "colorblind-friendly dark",
  "enableTelemetry": false,
  "model": "Claude Sonnet 4.6 (Thinking)",
  "permissions": {
    "allow": [
      "mcp(apple-calendar/*)",
      "command(argo get)",
      "command(bk artifacts)",
      "command(bk build list)",
      "command(bk build view)",
      "command(bk pipeline view)",
      "command(cat)",
      "command(curl --silent)",
      "command(curl -s)",
      "command(curl)",
      "command(d2)",
      "command(date)",
      "command(diff)",
      "command(echo)",
      "command(find)",
      "command(gh api)",
      "command(gh issue list)",
      "command(gh issue view)",
      "command(gh issue)",
      "command(gh pr checks)",
      "command(gh pr diff)",
      "command(gh pr list)",
      "command(gh pr review)",
      "command(gh pr status)",
      "command(gh pr view)",
      "command(gh release list)",
      "command(gh release view)",
      "command(gh repo view)",
      "command(gh run list)",
      "command(gh run view)",
      "command(gh search)",
      "command(gh workflow list)",
      "command(gh workflow view)",
      "command(git blame)",
      "command(git branch)",
      "command(git diff)",
      "command(git fetch)",
      "command(git log)",
      "command(git remote)",
      "command(git shortlog)",
      "command(git show)",
      "command(git stash list)",
      "command(git status)",
      "command(git tag)",
      "command(git worktree)",
      "command(grep -r)",
      "command(grep)",
      "command(head)",
      "command(jq)",
      "command(kubectl describe)",
      "command(kubectl explain)",
      "command(kubectl get)",
      "command(kubectl logs)",
      "command(kubectl top)",
      "command(ls)",
      "command(make lint)",
      "command(rg)",
      "command(tail)",
      "command(wc)"
