#!/usr/bin/env python3
import sys
import os
import subprocess
import argparse
import re

DEFAULT_DIR = os.path.expanduser("~/Google Drive/My Drive/media/memes")

def get_clipboard_url():
	"""Gets a URL from the macOS clipboard if it exists."""
	try:
		# pbpaste is a standard macOS utility to output clipboard contents
		result = subprocess.run(["pbpaste"], capture_output=True, text=True, check=True)
		content = result.stdout.strip()
		# Simple URL check
		if re.match(r'^https?://[^\s/$.?#].[^\s]*$', content):
			return content
	except Exception:
		pass
	return None

def main():
	parser = argparse.ArgumentParser(
		description="Download YouTube/Instagram videos in WhatsApp-compatible MP4 format (H.264/AAC)."
	)
	parser.add_argument("urls", nargs="*", help="One or more video URLs to download. If omitted, checks clipboard or prompts.")
	parser.add_argument(
		"-o", "--output-dir",
		default=DEFAULT_DIR,
		help=f"Directory to save the downloaded videos (default: {DEFAULT_DIR})."
	)
	parser.add_argument(
		"-a", "--audio-only",
		action="store_true",
		help="Download audio only (MP3 format)."
	)

	args = parser.parse_args()

	# Resolve output directory
	output_dir = os.path.abspath(os.path.expanduser(args.output_dir))

	# Get URLs to download
	urls = args.urls
	if not urls:
		clipboard_url = get_clipboard_url()
		if clipboard_url:
			print(f"\033[1;32mFound URL in clipboard:\033[0m {clipboard_url}")
			urls = [clipboard_url]
		else:
			try:
				url_input = input("Enter video URL to download: ").strip()
				if url_input:
					urls = [url_input]
				else:
					print("\033[1;31mNo URL provided. Exiting.\033[0m")
					sys.exit(0)
			except (KeyboardInterrupt, EOFError):
				print("\n\033[1;31mCancelled.\033[0m")
				sys.exit(0)

	# Ensure output directory exists
	os.makedirs(output_dir, exist_ok=True)

	# Base yt-dlp command
	cmd = ["yt-dlp"]

	if args.audio_only:
		cmd.extend([
			"-x",
			"--audio-format", "mp3",
			"--audio-quality", "0"
		])
	else:
		# Force H.264 (AVC) and AAC to guarantee WhatsApp compatibility.
		# YouTube & Instagram always provide H.264+AAC formats up to 1080p, which means fast downloads without transcoding.
		# If those are not available, it downloads best and uses ffmpeg to recode to standard MP4 (H.264/AAC).
		cmd.extend([
			"-f", "bv*[vcodec^=avc1]+ba[acodec^=mp4a]/best[ext=mp4]/best",
			"--merge-output-format", "mp4",
			"--recode-video", "mp4"
		])

	# Add output naming template (safe, clean filename format)
	cmd.extend([
		"--restrict-filenames",
		"-o", os.path.join(output_dir, "%(title)s.%(ext)s")
	])

	# Process downloads
	success_count = 0
	for url in urls:
		print(f"\n\033[1;34m[download-video]\033[0m Downloading {url}...")
		run_cmd = cmd + [url]
		try:
			subprocess.run(run_cmd, check=True)
			success_count += 1
		except subprocess.CalledProcessError as e:
			print(f"\033[1;31m[download-video] Failed to download:\033[0m {url}", file=sys.stderr)
		except KeyboardInterrupt:
			print("\n\033[1;33m[download-video] Download interrupted by user.\033[0m")
			break

	if success_count > 0:
		print(f"\n\033[1;32m[download-video] Successfully downloaded {success_count} file(s) to:\033[0m {output_dir}\n")

if __name__ == "__main__":
	main()
