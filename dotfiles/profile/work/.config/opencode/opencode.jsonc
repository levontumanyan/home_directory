{
	"$schema": "https://opencode.ai/config.json",
	"model": "openrouter/z-ai/glm-5.2",
	"small_model": "openrouter/anthropic/claude-haiku-4.5",
	"mcp": {
		"slack": {
			"type": "remote",
			"url": "https://mcp.slack.com/mcp",
			"oauth": {
				"clientId": "1601185624273.8899143856786",
				"redirectUri": "http://localhost:3118/callback"
			}
		},
		"buildkite-ro": {
			"type": "remote",
			"url": "https://mcp.buildkite.com/mcp/readonly"
		},
		"elastic-docs": {
			"type": "remote",
			"url": "https://www.elastic.co/docs/_mcp/"
		},
		"elastic-team-internal-docs": {
			"type": "remote",
			"url": "https://codex.elastic.dev/mcp"
		},
		"backstage": {
			"type": "local",
			"command": ["bash", "-c", "exec env BACKSTAGE_API_TOKEN=$(security find-generic-password -s backstage-api-proxy-token -a backstage -w) /Users/levontumanyan/repos/mcp-server-backstage/backstage-mcp"],
			"enabled": true,
			"environment": {
				"BACKSTAGE_BASE_URL": "https://api.backstage.elastic.dev"
			},
			"timeout": 10000
		}
	},
	"provider": {
		"openrouter": {
			"name": "OpenRouter",
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "https://openrouter.ai/api/v1",
				"apiKey": "{env:OPENROUTER_API_KEY}"
			}
		},
		"ollama": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama Local",
			"options": {
				"baseURL": "http://127.0.0.1:11434/v1"
			},
			"models": {
				"qwen2.5-coder:32b": {
					"name": "qwen2.5-coder:32b",
					"tools": true
				},
				"qwen3.5:35b-a3b": {
					"name": "qwen3.5:35b-a3b",
					"tools": true
				},
				"gemma4:12b-mlx": {
					"name": "Gemma 4 12B (MLX)",
					"tools": true
				}
			}
		},
		"mlx": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "MLX Local",
			"options": {
				"baseURL": "http://localhost:8080/v1"
			},
			"models": {
				"mlx-community/Qwen3.6-35B-A3B-4bit": {
					"name": "Qwen3-35B (MLX)",
					"tools": true
				},
				"mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit-DWQ": {
					"name": "Qwen3-Coder-30B (MLX)",
					"tools": true
				},
				"dotfiles-coder": {
					"name": "Dotfiles Coder (fine-tuned)",
					"tools": true
				}
			}
		}
	},
	"permission": {
		"read": {
			"~/repos/**": "allow"
		},
		"glob": {
			"~/repos/**": "allow"
		},
		"grep": {
			"~/repos/**": "allow"
		},
		"external_directory": {
			"~/repos/**": "allow"
		},
		"bash": {
			"argo get": "allow",
			"bk artifacts": "allow",
			"bk build list": "allow",
			"bk build view": "allow",
			"bk pipeline view": "allow",
			"cat": "allow",
			"curl": "allow",
			"curl --silent": "allow",
			"curl -s": "allow",
			"d2": "allow",
			"date": "allow",
			"diff": "allow",
			"echo": "allow",
			"find": "allow",
			"gh api": "allow",
			"gh issue": "allow",
			"gh issue list": "allow",
			"gh issue view": "allow",
			"gh pr checks": "allow",
			"gh pr diff": "allow",
			"gh pr list": "allow",
			"gh pr review": "allow",
			"gh pr status": "allow",
			"gh pr view": "allow",
			"gh release list": "allow",
			"gh release view": "allow",
			"gh repo view": "allow",
			"gh run list": "allow",
			"gh run view": "allow",
			"gh search": "allow",
			"gh workflow list": "allow",
			"gh workflow view": "allow",
			"git blame": "allow",
			"git branch": "allow",
			"git diff": "allow",
			"git fetch": "allow",
			"git log": "allow",
			"git remote": "allow",
			"git shortlog": "allow",
			"git show": "allow",
			"git stash list": "allow",
			"git status": "allow",
			"git tag": "allow",
			"git worktree": "allow",
			"grep": "allow",
			"grep -r": "allow",
			"head": "allow",
			"jq": "allow",
			"kubectl describe": "allow",
			"kubectl explain": "allow",
			"kubectl get": "allow",
			"kubectl logs": "allow",
			"kubectl top": "allow",
			"ls": "allow",
			"make lint": "allow",
			"rg": "allow",
			"tail": "allow",
			"wc": "allow"
		},
		"webfetch": "allow"
	}
}
