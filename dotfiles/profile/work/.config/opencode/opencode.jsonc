{
	"$schema": "https://opencode.ai/config.json",
	"model": "openrouter/~openai/gpt-luna-latest",
	"small_model": "openrouter/anthropic/claude-haiku-4.5",
	"mcp": {
		"sessions": {
			"type": "local",
			"command": ["sessions", "--mcp"],
			"enabled": true
		},
		"slack": {
			"type": "remote",
			"url": "https://mcp.slack.com/mcp",
			"oauth": {
				"clientId": "1601185624273.8899143856786",
				"redirectUri": "http://localhost:3118/callback"
			}
		},
		"buildkite-ro": {
			"type": "remote",
			"url": "https://mcp.buildkite.com/mcp/readonly"
		},
		"elastic-docs": {
			"type": "remote",
			"url": "https://www.elastic.co/docs/_mcp/"
		},
		"elastic-team-internal-docs": {
			"type": "remote",
			"url": "https://codex.elastic.dev/mcp"
		},
		"backstage": {
			"type": "local",
			"command": ["bash", "-c", "exec env BACKSTAGE_API_TOKEN=$(security find-generic-password -s backstage-api-proxy-token -a backstage -w) /Users/levontumanyan/repos/mcp-server-backstage/backstage-mcp"],
			"enabled": true,
			"environment": {
				"BACKSTAGE_BASE_URL": "https://api.backstage.elastic.dev"
			},
			"timeout": 10000
		}
	},
	"providers": {
		"amazon-bedrock": {
			"api": {
				"type": "native",
				"settings": {
					"region": "us-gov-east-1"
				}
			},
			"options": {
				"region": "us-gov-east-1"
			},
			"models": {
				"us-gov.xai.grok-4.6": {
					"name": "Grok 4.6 (GovCloud FRS)",
					"attachment": true,
					"reasoning": true,
					"tool_call": true,
					"cost": {
						"input": 2.64,
						"output": 7.92,
						"cache_read": 0.66
					},
					"limit": {
						"context": 500000,
						"output": 500000
					}
				},
				"us-gov.anthropic.claude-sonnet-4-5-20250929-v1:0": {
					"name": "Claude Sonnet 4.5 (GovCloud FRS)",
					"attachment": true,
					"reasoning": true,
					"tool_call": true,
					"cost": {
						"input": 3,
						"output": 15,
						"cache_read": 0.3,
						"cache_write": 3.75
					},
					"limit": {
						"context": 200000,
						"output": 64000
					}
				},
				"us-gov.anthropic.claude-opus-4-8": {
					"name": "Claude Opus 4.8 (GovCloud FRS)",
					"attachment": true,
					"reasoning": true,
					"tool_call": true,
					"cost": {
						"input": 5,
						"output": 25,
						"cache_read": 0.5,
						"cache_write": 6.25
					},
					"limit": {
						"context": 1000000,
						"output": 128000
					}
				},
				"us-gov.anthropic.claude-sonnet-5": {
					"name": "Claude Sonnet 5 (GovCloud FRS)",
					"attachment": true,
					"reasoning": true,
					"tool_call": true,
					"cost": {
						"input": 2,
						"output": 10,
						"cache_read": 0.2,
						"cache_write": 2.5
					},
					"limit": {
						"context": 1000000,
						"output": 128000
					}
				},
				"us-gov.anthropic.claude-opus-5": {
					"name": "Claude Opus 5 (GovCloud FRS)",
					"attachment": true,
					"reasoning": true,
					"tool_call": true,
					"cost": {
						"input": 5,
						"output": 25,
						"cache_read": 0.5,
						"cache_write": 6.25
					},
					"limit": {
						"context": 1000000,
						"output": 128000
					}
				}
			}
		},
		"openrouter": {
			"api": {
				"type": "aisdk",
				"package": "@ai-sdk/openai-compatible",
				"settings": {
					"baseURL": "https://openrouter.ai/api/v1",
					"apiKey": "{env:OPENROUTER_API_KEY}"
				}
			},
			"name": "OpenRouter",
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "https://openrouter.ai/api/v1",
				"apiKey": "{env:OPENROUTER_API_KEY}"
			},
			"models": {
				"~openai/gpt-luna-latest": {
					"request": {
						"variant": "xhigh"
					}
				}
			}
		},
		"ollama": {
			"api": {
				"type": "aisdk",
				"package": "@ai-sdk/openai-compatible",
				"settings": {
					"baseURL": "http://127.0.0.1:11434/v1"
				}
			},
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama Local",
			"options": {
				"baseURL": "http://127.0.0.1:11434/v1"
			},
			"models": {
				"qwen2.5-coder:32b": {
					"name": "qwen2.5-coder:32b",
					"tools": true
				},
				"qwen3.5:35b-a3b": {
					"name": "qwen3.5:35b-a3b",
					"tools": true
				},
				"gemma4:12b-mlx": {
					"name": "Gemma 4 12B (MLX)",
					"tools": true
				}
			}
		},
		"mlx": {
			"api": {
				"type": "aisdk",
				"package": "@ai-sdk/openai-compatible",
				"settings": {
					"baseURL": "http://localhost:8080/v1"
				}
			},
			"npm": "@ai-sdk/openai-compatible",
			"name": "MLX Local",
			"options": {
				"baseURL": "http://localhost:8080/v1"
			},
			"models": {
				"mlx-community/Qwen3.6-35B-A3B-4bit": {
					"name": "Qwen3-35B (MLX)",
					"tools": true
				},
				"mlx-community/Qwen3-Coder-30B-A3B-Instruct-4bit-DWQ": {
					"name": "Qwen3-Coder-30B (MLX)",
					"tools": true
				},
				"dotfiles-coder": {
					"name": "Dotfiles Coder (fine-tuned)",
					"tools": true
				}
			}
		}
	},
	"agent": {
		"build": {
			"model": "openrouter/~openai/gpt-luna-latest",
			"variant": "xhigh"
		},
		"vision": {
			"description": "Delegates vision capabilities to a vision-capable subagent for processing images, screenshots, and other media files that the primary model cannot handle",
			"mode": "subagent",
			"model": "openrouter/minimax/minimax-m3",
			"temperature": 0.2,
			"permission": {
				"read": "allow",
				"glob": "allow",
				"grep": "allow",
				"bash": "allow",
				"task": "allow",
				"todowrite": "allow",
				"external_directory": "allow",
				"webfetch": "deny",
				"websearch": "deny",
				"doom_loop": "deny"
			}
		}
	},
	"permission": {
		"read": {
			"~/repos/**": "allow",
			"/tmp/**": "allow",
			"/private/tmp/**": "allow"
		},
		"edit": {
			"/tmp/**": "allow",
			"/private/tmp/**": "allow"
		},
		"glob": {
			"~/repos/**": "allow",
			"/tmp/**": "allow",
			"/private/tmp/**": "allow"
		},
		"grep": {
			"~/repos/**": "allow",
			"/tmp/**": "allow",
			"/private/tmp/**": "allow"
		},
		"external_directory": {
			"~/repos/**": "allow",
			"/tmp/**": "allow",
			"/private/tmp/**": "allow"
		},
		"bash": {
			"argo get": "allow",
			"bk artifacts": "allow",
			"bk build list": "allow",
			"bk build view": "allow",
			"bk pipeline view": "allow",
			"cat": "allow",
			"curl": "allow",
			"curl --silent": "allow",
			"curl -s": "allow",
			"d2": "allow",
			"date": "allow",
			"diff": "allow",
			"echo": "allow",
			"find": "allow",
			"gh api": "allow",
			"gh issue": "allow",
			"gh issue list": "allow",
			"gh issue view": "allow",
			"gh pr checks": "allow",
			"gh pr diff": "allow",
			"gh pr list": "allow",
			"gh pr review": "allow",
			"gh pr status": "allow",
			"gh pr view": "allow",
			"gh release list": "allow",
			"gh release view": "allow",
			"gh repo view": "allow",
			"gh run list": "allow",
			"gh run view": "allow",
			"gh search": "allow",
			"gh workflow list": "allow",
			"gh workflow view": "allow",
			"git blame": "allow",
			"git branch": "allow",
			"git diff": "allow",
			"git fetch": "allow",
			"git log": "allow",
			"git remote": "allow",
			"git shortlog": "allow",
			"git show": "allow",
			"git stash list": "allow",
			"git status": "allow",
			"git tag": "allow",
			"git worktree": "allow",
			"grep": "allow",
			"grep -r": "allow",
			"head": "allow",
			"jq": "allow",
			"kubectl describe": "allow",
			"kubectl explain": "allow",
			"kubectl get": "allow",
			"kubectl logs": "allow",
			"kubectl top": "allow",
			"ls": "allow",
			"make lint": "allow",
			"rg": "allow",
			"tail": "allow",
			"wc": "allow"
		},
		"webfetch": "allow"
	}
}
